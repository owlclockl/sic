/* =====================================================================
   DEADLOCK :: BHOP TRAINER — стили панели (Valve Panorama CSS)

   Токены взяты из игрового citadel_base_styles.css:
     baseText #FFEFD7 · offBlack #10130D · goldColor #FFED79
     soulColor #70F8C1 · colorEnemy #FF410D · deadlockGreenDark #47A36C
     шрифты: Reaver (serif, ар-деко), Radiance (sans), Retail Text Demo (mono)

   Важно: в Panorama нет псевдоэлементов, поэтому все украшения —
   отдельные Panel-ы из bhop_trainer.vxml.
   ===================================================================== */

@define bhoptText:        #FFEFD7;
@define bhoptTextDim:     #FFEFD7A8;
@define bhoptTextDimmer:  #FFEFD75C;
@define bhoptGold:        #FFED79;
@define bhoptSoul:        #70F8C1;
@define bhoptEnemy:       #FF410D;
@define bhoptBackdrop:    #10130DEE;
@define bhoptBackdropIn:  #00000040;
@define bhoptHairline:    #FFED7961;
@define bhoptHairlineDim: #FFEFD724;

/* ------------------------------- корень ------------------------------ */
.bhopt_root
{
	width: 100%;
	height: 100%;
}

/* ------------------------------ панель ------------------------------- */
.bhopt_panel
{
	horizontal-align: left;
	vertical-align: top;
	margin-left: 28px;
	margin-top: 120px;
	width: 470px;
	background-color: bhoptBackdrop;
	border: 1px solid bhoptHairline;
	box-shadow: 0px 2px 0px #FFED791A;
	flow-children: down;
}

/* ------------------------- угловые скобки ---------------------------- */
.bhopt_corner
{
	width: 14px;
	height: 14px;
	border: 1px solid bhoptHairline;
	opacity: 0.75;
}

.bhopt_corner_tl
{
	margin-left: 20px;
	margin-top: 112px;
	border-right: 0px;
	border-bottom: 0px;
}

.bhopt_corner_tr
{
	horizontal-align: left;
	margin-left: 512px;
	margin-top: 112px;
	border-left: 0px;
	border-bottom: 0px;
}

.bhopt_corner_bl
{
	vertical-align: top;
	margin-left: 20px;
	margin-top: 328px;
	border-right: 0px;
	border-top: 0px;
}

.bhopt_corner_br
{
	horizontal-align: left;
	margin-left: 512px;
	margin-top: 328px;
	border-left: 0px;
	border-top: 0px;
}

/* ------------------------------ шапка -------------------------------- */
.bhopt_plate
{
	width: 100%;
	padding: 14px 16px 6px 16px;
	flow-children: right;
}

.bhopt_brand
{
	font-family: Radiance;
	font-size: 10px;
	letter-spacing: 3px;
	text-transform: uppercase;
	color: bhoptTextDimmer;
	vertical-align: center;
}

.bhopt_stepno
{
	font-family: Reaver;
	font-size: 22px;
	letter-spacing: 3px;
	color: bhoptGold;
	horizontal-align: right;
	vertical-align: center;
	animation-name: bhopt_pulse;
	animation-duration: 2.6s;
	animation-iteration-count: infinite;
	animation-timing-function: ease-in-out;
}

@keyframes bhopt_pulse
{
	0%   { opacity: 1.0; }
	50%  { opacity: 0.45; }
	100% { opacity: 1.0; }
}

.bhopt_steptitle
{
	margin: 2px 16px 0px 16px;
	font-family: Reaver;
	font-size: 19px;
	letter-spacing: 4px;
	text-transform: uppercase;
	color: bhoptText;
}

/* ---------------------------- разделитель ---------------------------- */
.bhopt_divider
{
	width: 100%;
	height: 18px;
	padding: 8px 16px 0px 16px;
	flow-children: right;
}

.bhopt_rule
{
	height: 1px;
	vertical-align: center;
	width: fill-parent-flow(1.0);
	background-color: gradient( linear, 0% 0%, 100% 0%, from( #FFED7900 ), color-stop( 0.5, bhoptHairline ), to( #FFED7900 ) );
}

.bhopt_diamond
{
	width: 7px;
	height: 7px;
	margin: 0px 10px 0px 10px;
	vertical-align: center;
	background-color: bhoptGold;
	opacity: 0.85;
	animation-name: bhopt_pulse;
	animation-duration: 2.6s;
	animation-iteration-count: infinite;
	animation-timing-function: ease-in-out;
}

/* ----------------------------- строки -------------------------------- */
.bhopt_rows
{
	width: 100%;
	padding: 6px 16px 12px 16px;
	flow-children: down;
}

.bhopt_row
{
	width: 100%;
	height: 22px;
	flow-children: right;
}

.bhopt_k
{
	width: 130px;
	font-family: Radiance;
	font-size: 12px;
	color: bhoptTextDimmer;
	vertical-align: center;
}

.bhopt_v
{
	font-family: Radiance;
	font-size: 13px;
	color: bhoptText;
	vertical-align: center;
}

.bhopt_v_accent
{
	color: bhoptGold;
}

/* ------------------------------ подвал ------------------------------- */
.bhopt_foot
{
	width: 100%;
	padding: 10px 16px 12px 16px;
	background-color: bhoptBackdropIn;
	border-top: 1px solid bhoptHairlineDim;
	flow-children: right;
}

.bhopt_key
{
	font-family: Reaver;
	font-size: 12px;
	color: bhoptGold;
	border: 1px solid bhoptHairline;
	background-color: #FFED790D;
	padding: 2px 7px 2px 7px;
	margin-right: 6px;
	vertical-align: center;
}

.bhopt_keylabel
{
	font-family: Radiance;
	font-size: 11px;
	color: bhoptTextDimmer;
	margin-right: 14px;
	vertical-align: center;
}
