<!-- =====================================================================
     DEADLOCK :: BHOP TRAINER — сниппет для hud.xml (Valve Panorama)
     -----------------------------------------------------------------
     Куда вставлять: в конец извлечённого vanilla-файла
         panorama/layout/hud.xml
     перед закрывающим тегом </CitadelHud>

     Дизайн: палитра игры (cream #FFEFD7 / gold #FFED79 / soul #70F8C1),
     ар-деко: хайрлайн-рамка, ромбовидные акценты сделаны отдельными
     Panel-ами (псевдоэлементов в Panorama нет).

     Статичный текст: правки шага делаются прямо здесь, в text="".
     Чтобы панель управлялась из cfg (показ/скрытие) — нужен vjs-скрипт,
     см. README, раздел «Динамика».
     ===================================================================== -->

<Panel class="bhopt_root" hittest="false" hittestchildren="false">

  <!-- декоративные угловые скобки -->
  <Panel class="bhopt_corner bhopt_corner_tl" />
  <Panel class="bhopt_corner bhopt_corner_tr" />
  <Panel class="bhopt_corner bhopt_corner_bl" />
  <Panel class="bhopt_corner bhopt_corner_br" />

  <Panel class="bhopt_panel">

    <!-- шапка: бренд + номер шага -->
    <Panel class="bhopt_plate">
      <Label class="bhopt_brand" text="DEADLOCK :: BHOP TRAINER" />
      <Label class="bhopt_stepno" text="01" />
    </Panel>

    <Label class="bhopt_steptitle" text="A I R   S T R A F E" />

    <!-- золотой разделитель с ромбом -->
    <Panel class="bhopt_divider">
      <Panel class="bhopt_rule" />
      <Panel class="bhopt_diamond" />
      <Panel class="bhopt_rule" />
    </Panel>

    <!-- строки подсказки: label / value -->
    <Panel class="bhopt_rows">
      <Panel class="bhopt_row">
        <Label class="bhopt_k" text="в воздухе" />
        <Label class="bhopt_v" text="ОТПУСТИ W" />
      </Panel>
      <Panel class="bhopt_row">
        <Label class="bhopt_k" text="страф" />
        <Label class="bhopt_v" text="держи A (или D)" />
      </Panel>
      <Panel class="bhopt_row">
        <Label class="bhopt_k" text="мышь" />
        <Label class="bhopt_v" text="плавно в ту же сторону" />
      </Panel>
      <Panel class="bhopt_row">
        <Label class="bhopt_k" text="работает" />
        <Label class="bhopt_v bhopt_v_accent" text="ниже ~450 u/s" />
      </Panel>
    </Panel>

    <!-- подвал: клавиши -->
    <Panel class="bhopt_foot">
      <Label class="bhopt_key" text="J" />
      <Label class="bhopt_keylabel" text="шаг" />
      <Label class="bhopt_key" text="M" />
      <Label class="bhopt_keylabel" text="скорость" />
      <Label class="bhopt_key" text="H" />
      <Label class="bhopt_keylabel" text="чек-лист" />
    </Panel>

  </Panel>
</Panel>
