{
  "name": "reveal-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reveal Atlas — интерактивная карта мира, которая открывается по клеткам",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-single-file.mjs",
    "build:single": "tsc --noEmit && vite build && node scripts/build-single-file.mjs",
    "build:colab": "node scripts/build-colab-notebook.mjs",
    "preview": "vite preview",
    "online": "node server/index.mjs",
    "start": "node server/index.mjs",
    "online:tunnel": "node scripts/online-tunnel.mjs",
    "test:online": "node scripts/online-selftest.mjs && node scripts/online-client-selftest.mjs",
    "test:online:server": "node scripts/online-selftest.mjs",
    "test:online:client": "node scripts/online-client-selftest.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
