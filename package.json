{
  "name": "reveal-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reveal Atlas — интерактивная карта мира, которая открывается по клеткам",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-single-file.mjs",
    "build:single": "tsc --noEmit && vite build && node scripts/build-single-file.mjs",
    "build:colab": "node scripts/build-colab-notebook.mjs",
    "preview": "vite preview",
    "online": "node server/index.mjs",
    "start": "node server/index.mjs",
    "online:tunnel": "node scripts/online-tunnel.mjs",
    "phone": "node scripts/phone-access.mjs",
    "apk:qr": "node scripts/phone-access.mjs --url https://github.com/owlclockl/sic/releases/download/android-latest/RevealAtlas.apk --out phone-apk.png",
    "cloudflared": "node scripts/install-cloudflared.mjs",
    "icons": "node scripts/build-app-icons.mjs",
    "android:sync": "npm run build && node scripts/build-app-icons.mjs && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test:online": "node scripts/online-selftest.mjs && node scripts/online-client-selftest.mjs",
    "test:online:server": "node scripts/online-selftest.mjs",
    "test:online:client": "node scripts/online-client-selftest.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "qrcode": "^1.5.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
